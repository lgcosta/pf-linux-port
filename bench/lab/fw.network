version: 2
ethernets:
  mgmt:
    match: {macaddress: "52:54:00:0b:01:03"}
    dhcp4: true
  benchlan:
    match: {macaddress: "52:54:00:0b:02:03"}
    addresses: [10.0.0.1/24]
  benchwan:
    match: {macaddress: "52:54:00:0b:02:04"}
    addresses: [10.0.1.1/24]
    routes:
      - {to: 10.0.0.0/24, via: 10.0.0.2}
