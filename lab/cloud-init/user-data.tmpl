#cloud-config
# Rendered per VM by scripts/vm-create.sh (tokens: @...@).
hostname: @VM@
manage_etc_hosts: true
ssh_pwauth: true
users:
  - name: root
    lock_passwd: false
    ssh_authorized_keys:
      - @SSH_PUBKEY@
chpasswd:
  expire: false
  users:
    - name: root
      password: "@ROOT_PASS@"
      type: text
package_update: true
packages: @LAB_PACKAGES@
runcmd:
  - |
    printf 'net.ipv4.ip_forward=1\nnet.ipv4.conf.all.rp_filter=0\nnet.ipv4.conf.default.rp_filter=0\n' > /etc/sysctl.d/00-pflab.conf
    sysctl -q -p /etc/sysctl.d/00-pflab.conf
    for f in /proc/sys/net/ipv4/conf/*/rp_filter; do echo 0 > "$f"; done
  - "printf '@ROOT_PASS@\\n@ROOT_PASS@\\n' | passwd root >/dev/null 2>&1 || true"
@RUNCMD_EXTRA@
  - touch /run/pf-lab-ready
